# EVRÉVIA MVP Configuration
# Copy this file to .env and fill in your details

# 1. MongoDB Connection
# Get this from MongoDB Atlas (Cluster -> Connect -> Connect your application)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"

# 2. JWT Security
# Generate a secure random string for this
JWT_SECRET="super-secret-key-change-me"

# 3. Email Verifier Worker (Optional - for Phase 6 manual verification)
# Use a Gmail App Password, NOT your regular email password
VERIFY_EMAIL_ACCOUNT="your_store_email@gmail.com"
VERIFY_EMAIL_PASSWORD="xxxx xxxx xxxx xxxx"

# 4. Firebase API Key (For Phone OTP verification on the backend)
# You get this from Firebase Project Settings -> General -> Web App -> apiKey
FIREBASE_API_KEY="AIzaSy...your-firebase-api-key"
